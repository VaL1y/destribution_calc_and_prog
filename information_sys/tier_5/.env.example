# Copy this file to .env on BOTH physical servers.
# Use addresses that containers on both hosts can reach (for example WireGuard IPs).
REMOTE_HOST=10.30.0.11
LOCAL_HOST=10.30.0.21

CLUSTER_NAME=warehouse-tier5

POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-app-password
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-superuser-password
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=change-replication-password

# Ports published on the remote physical server.
PG1_PORT=5433
PG2_PORT=5434
PATRONI1_REST_PORT=8008
PATRONI2_REST_PORT=8009
ZK1_CLIENT_PORT=2181
ZK1_PEER_PORT=2888
ZK1_ELECTION_PORT=3888
ZK2_CLIENT_PORT=2182
ZK2_PEER_PORT=2889
ZK2_ELECTION_PORT=3889

# Ports published on the local physical server.
PG3_PORT=5432
PATRONI3_REST_PORT=8008
ZK3_CLIENT_PORT=2181
ZK3_PEER_PORT=2888
ZK3_ELECTION_PORT=3888

API_PORT=8000
API_WORKERS=2
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=3
